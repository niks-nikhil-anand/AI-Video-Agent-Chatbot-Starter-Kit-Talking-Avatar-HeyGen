# LiveAvatar API Configuration
# Get your API Key from https://app.liveavatar.com
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here

# Google Gemini API Key
# Get your API Key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Your avatar ID from https://app.liveavatar.com → Avatars
# Leave empty to use the free sandbox avatar
LIVEAVATAR_AVATAR_ID=

# Your context ID (Knowledge Base)
# Create once via: POST https://api.liveavatar.com/v1/contexts
# Leave empty to run in sandbox mode
LIVEAVATAR_CONTEXT_ID=
